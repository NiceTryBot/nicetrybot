# --- The app: on this server, or on a remote -----------------------------------------------------
#
# The app's commands are calls to its MCP server's tools, the ones an AI agent uses. On a server they
# go to the stack here (php artisan nicetry:mcp, as the team's owner); from anywhere else they go to a
# remote's /mcp over HTTPS with an API token an administrator made in Admin → API tokens. Either way
# it's the same message, the same tools and the same answer.

config_dir=${NICETRYBOT_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/nicetrybot}
remotes=$config_dir/remotes
current_remote_file=$config_dir/current-remote
mcp_protocol=2026-07-28

remote_opt=
use_local=false
team_opt=
json_out=false
app_remote=
app_team=

need_jq() {
  command -v jq >/dev/null 2>&1 && return 0
  if [[ $(uname -s) == Linux && $EUID -eq 0 ]] && command -v apt-get >/dev/null 2>&1; then
    say "Installing jq, which reads the app's answers"
    if DEBIAN_FRONTEND=noninteractive apt-get install -y -qq jq >/dev/null 2>&1 ||
      { apt-get update -qq >/dev/null 2>&1 && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq jq >/dev/null 2>&1; }; then
      return 0
    fi
  fi
  fail "This needs jq: brew install jq (macOS before 15), or apt-get install jq"
}

remote_get() { sed -n "s/^$2=//p" "$remotes/$1" 2>/dev/null | tail -n 1; }

# The team a remote's commands work on, in words: its token's team, or the one picked for a token for
# all teams.
remote_team() {
  if [[ $(remote_get "$1" all_teams) != yes ]]; then
    printf 'team %s' "$(remote_get "$1" team)"
  elif [[ -n $(remote_get "$1" team_slug) ]]; then
    printf 'team %s (token for all teams)' "$(remote_get "$1" team)"
  else
    printf 'no team picked yet (token for all teams)'
  fi
}
valid_remote_name() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }
looks_like_api_token() { [[ $1 =~ ^ntb_[A-Za-z0-9]{48}$ ]]; }

# A panel's address, from what was typed: app.example.com, https://app.example.com/ or …/mcp.
panel_url() {
  local url=$1
  [[ $url == *://* ]] || url="https://$url"
  url=${url%/}
  url=${url%/mcp}
  url=${url%/}
  [[ $url =~ ^https?://[A-Za-z0-9.-]+(:[0-9]+)?$ ]] || fail "That isn't a panel's address: $1 (like app.example.com)"
  printf '%s' "$url"
}

# Where the app's commands go: --local, else --remote (or NICETRYBOT_REMOTE), else the current remote,
# else this server's stack.
resolve_app_target() {
  app_remote=
  [[ $use_local == true ]] && return 0
  app_remote=${remote_opt:-${NICETRYBOT_REMOTE:-}}
  [[ -z $app_remote && -s $current_remote_file ]] && app_remote=$(cat "$current_remote_file")
  if [[ -n $app_remote ]]; then
    [[ -f $remotes/$app_remote ]] || fail "No remote called $app_remote ($(cmd "nicetrybot remote list"))"
    app_team=${team_opt:-$(remote_get "$app_remote" team_slug)}
    return 0
  fi
  [[ -f $dir/.env && -f $dir/compose.yml ]] ||
    fail "No remote yet, and there's no NiceTryBot on this machine. Add your panel: $(cmd "nicetrybot remote add app.example.com")"
}

# Who the commands act as, on stderr and on a terminal only, so a change never lands somewhere unexpected.
say_target() {
  [[ -t 2 ]] || return 0
  if [[ -n $app_remote ]]; then
    local team
    team=$(remote_team "$app_remote")
    [[ -n $team_opt ]] && team="team $team_opt"
    printf '%s→ %s (%s), %s%s\n' "$c_dim" "$app_remote" "$(remote_get "$app_remote" url)" "$team" "$c_reset" >&2
  else
    printf '%s→ this server (%s)%s%s\n' "$c_dim" "$dir" "${team_opt:+, team $team_opt}" "$c_reset" >&2
  fi
}

# POST one JSON-RPC message to a panel's /mcp and print the answer. The token goes to curl on its
# standard input, never on its command line, where anyone on the machine could read it.
mcp_post() {
  local url=$1 api_token=$2 method=$3 name=$4 body=$5 work code
  work=$(mktemp -d "${TMPDIR:-/tmp}/nicetrybot.XXXXXX")
  printf '%s' "$body" >"$work/body"
  code=$(printf 'header = "Authorization: Bearer %s"\n' "$api_token" |
    curl -sS -m 120 -K - -o "$work/answer" -w '%{http_code}' \
      -H 'Content-Type: application/json' -H 'Accept: application/json, text/event-stream' \
      -H "MCP-Protocol-Version: $mcp_protocol" -H "Mcp-Method: $method" ${name:+-H "Mcp-Name: $name"} \
      --data-binary "@$work/body" "$url/mcp" 2>"$work/error") || {
    local error
    error=$(cat "$work/error")
    rm -rf "$work"
    fail "Couldn't reach $url: ${error#curl: }"
  }
  # A streamed answer arrives as server-sent events: the last one is the result.
  if grep -q '^data: ' "$work/answer"; then
    sed -n 's/^data: //p' "$work/answer" | tail -n 1 >"$work/result"
    mv -f "$work/result" "$work/answer"
  fi
  if ! jq -e 'has("jsonrpc")' "$work/answer" >/dev/null 2>&1; then
    rm -rf "$work"
    # Without a working token the API isn't there at all: the same 404 as any made-up path.
    [[ $code == 404 ]] && fail "$url doesn't take that token: it expired or was deleted, its user isn't an administrator any more, or there's no NiceTryBot there. Make a new one at $(link_to "${url%/}/admin/tokens"), then: $(cmd "nicetrybot remote auth")"
    fail "$url answered HTTP $code"
  fi
  cat "$work/answer"
  rm -rf "$work"
}

# A JSON-RPC request, stateless (protocol 2026-07-28): no initialize first, each one says who it is.
mcp_body() {
  jq -nc --arg method "$1" --argjson params "$2" --arg version "$mcp_protocol" \
    '{jsonrpc: "2.0", id: 1, method: $method, params: ($params + {_meta: {"io.modelcontextprotocol/protocolVersion": $version, "io.modelcontextprotocol/clientCapabilities": {}}})}'
}

# One JSON-RPC request to the app (here or on the remote); prints the answer.
mcp_request() {
  local method=$1 params=$2 name=${3:-} body output
  body=$(mcp_body "$method" "$params")
  if [[ -n $app_remote ]]; then
    mcp_post "$(remote_get "$app_remote" url)" "$(remote_get "$app_remote" token)" "$method" "$name" "$body"
    return
  fi
  require_stack
  output=$(compose exec -T app php artisan nicetry:mcp ${team_opt:+"--team=$team_opt"} <<<"$body" 2>&1) || {
    grep -q 'nicetry:mcp.*not defined\|There are no commands defined' <<<"$output" &&
      fail "This release runs the app's commands on a newer one: $(cmd "nicetrybot update")"
    [[ -n $output ]] || output="The app didn't answer: $(cmd "nicetrybot logs app")"
    fail "$output"
  }
  printf '%s\n' "$output" | grep '^{' | tail -n 1
}

# Call a tool and print what it answered (structured, as JSON); a tool's error stops the command.
mcp_tool() {
  local tool=$1 arguments=${2:-'{}'} answer message
  if [[ -n $app_remote ]]; then
    if [[ -n $app_team ]]; then
      arguments=$(jq -c --arg team "$app_team" '{team: $team} + .' <<<"$arguments")
    elif [[ $(remote_get "$app_remote" all_teams) == yes && $tool != whoami ]]; then
      fail "$app_remote's token works on all your teams: pick one with $(cmd "nicetrybot team use SLUG") ($(cmd "nicetrybot teams") lists them), or add $(cmd --team=SLUG)"
    fi
  fi
  answer=$(mcp_request tools/call "$(jq -nc --arg name "$tool" --argjson arguments "$arguments" '{name: $name, arguments: $arguments}')" "$tool") || exit 1
  message=$(jq -r '.error.message // empty' <<<"$answer")
  if [[ $message == "Tool [$tool] not found." ]]; then
    fail "${app_remote:-This server}'s NiceTryBot has no $tool tool: it needs a newer release, or the token isn't allowed to ($(cmd "nicetrybot tools"))"
  fi
  [[ -n $message ]] && fail "$message"
  if [[ $(jq -r '.result.isError // false' <<<"$answer") == true ]]; then
    fail "$(jq -r '[.result.content[]? | .text // empty] | join("\n")' <<<"$answer")"
  fi
  jq -c '.result.structuredContent // (.result.content[0].text // "" | (fromjson? // .))' <<<"$answer"
}

# Any answer, readably: nested keys indented, lists as "- " items, and lists of single words on one line.
render_jq='
  def scalar: if . == "" or . == null then "-" elif type == "string" then . elif . == true then "yes" elif . == false then "no" else tojson end;
  def render($i):
    if type == "object" then
      to_entries[] | (.key | gsub("_"; " ")) as $k | .value |
        if type == "object" and length > 0 then "\($i)\($k):", render($i + "  ")
        elif (type == "object" or type == "array") and length == 0 then "\($i)\($k): none"
        elif type == "array" and all(.[]; type != "object" and type != "array" and (tostring | test(" ") | not)) then "\($i)\($k): \(map(scalar) | join(", "))"
        elif type == "array" then "\($i)\($k):", render($i + "  ")
        else "\($i)\($k): \(scalar)" end
    elif type == "array" then
      .[] | [render("")] | to_entries[] | (if .key == 0 then "\($i)- " else "\($i)  " end) + .value
    else "\($i)\(scalar)" end;
  render("")'

show() {
  if [[ $json_out == true ]]; then jq . <<<"$1"; else jq -r "$render_jq" <<<"$1"; fi
}

# Call a tool and show its answer. (A failure inside $(…) doesn't stop the script on bash 3.2, hence
# the || exit after each one that can fail.)
run_tool() {
  local answer
  answer=$(mcp_tool "$@") || exit 1
  show "$answer"
}

# Columns of tab-separated lines, as wide as their widest cell.
# Colors don't count toward a cell's width, and a first line that starts with HEADER: is the bold heading.
table() {
  awk -F'\t' -v bold="$c_bold" -v dim="$c_dim" -v reset="$c_reset" '
    function shown(text) { gsub(/\033\[[0-9;]*m/, "", text); return length(text) }
    NR == 1 && sub(/^HEADER:/, "") { heading = 1 }
    { for (i = 1; i <= NF; i++) { cell[NR, i] = $i; if (shown($i) > width[i]) width[i] = shown($i) } if (NF > cols) cols = NF }
    END {
      for (r = 1; r <= NR; r++) {
        line = ""
        for (i = 1; i <= cols; i++) {
          line = line cell[r, i]
          if (i < cols) line = line sprintf("%" (width[i] - shown(cell[r, i]) + 2) "s", "")
        }
        sub(/ +$/, "", line)
        print (r == 1 && heading ? bold line reset : line)
      }
    }'
}

app_command() {
  need_jq
  resolve_app_target
  say_target
}

cmd_whoami() {
  app_command
  run_tool whoami
}

# teams: the teams the current remote's token works on, * marking the one in use.
cmd_teams() {
  app_command
  [[ -n $app_remote ]] || fail "On this server, name the team with --team=SLUG (the first administrator's when left out)"
  local answer
  answer=$(mcp_tool whoami) || exit 1
  if [[ $json_out == true ]]; then
    jq '.teams // [.team]' <<<"$answer"
    return 0
  fi
  {
    printf 'HEADER: \tSLUG\tTEAM\n'
    jq -r --arg current "$app_team" --arg on "$c_green" --arg off "$c_reset" '(.teams // [.team])[] | [(if .slug == $current then $on + "*" + $off else " " end), .slug, .name] | @tsv' <<<"$answer"
  } | table
  if [[ $(jq -r '.all_teams // false' <<<"$answer") != true ]]; then
    echo
    echo "This token works on $(jq -r .team.name <<<"$answer") only. For all your teams, make one at $(remote_get "$app_remote" url)/admin/tokens"
  elif [[ -z $app_team ]]; then
    echo
    next_step "pick the team to work on: $(cmd "nicetrybot team use SLUG")"
  fi
}

# team: the team the current remote's commands work on; team use SLUG switches, for a token for all teams.
cmd_team() {
  local action=${1:-}
  [[ $# -gt 0 ]] && shift
  case $action in
    '')
      app_command
      [[ -n $app_remote ]] || fail "On this server, name the team with --team=SLUG (the first administrator's when left out)"
      echo "$app_remote: $(remote_team "$app_remote")"
      ;;
    list | ls) cmd_teams ;;
    use | switch | *)
      [[ $action == use || $action == switch ]] || set -- "$action" "$@"
      [[ $# -eq 1 ]] || fail "$(cmd "nicetrybot team use SLUG") ($(cmd "nicetrybot teams") lists them)"
      need_jq
      resolve_app_target
      [[ -n $app_remote ]] || fail "On this server, name the team with --team=SLUG (the first administrator's when left out)"
      local url api_token details
      url=$(remote_get "$app_remote" url)
      api_token=$(remote_get "$app_remote" token)
      details=$(token_details "$url" "$api_token" "$1") || exit 1
      save_remote "$app_remote" "$url" "$api_token" "$details"
      done_ "$app_remote now works on $(remote_team "$app_remote")."
      ;;
  esac
}

cmd_tools() {
  app_command
  local answer
  answer=$(mcp_request tools/list '{}') || exit 1
  [[ -n $(jq -r '.error.message // empty' <<<"$answer") ]] && fail "$(jq -r .error.message <<<"$answer")"
  if [[ $json_out == true ]]; then
    jq '.result.tools' <<<"$answer"
    return 0
  fi
  jq -r --arg on "$c_cyan" --arg off "$c_reset" '.result.tools[] | [$on + .name + $off, (.description | gsub("\\s+"; " ") | sub("^ "; "") | split(". ")[0] | sub("\\.$"; "") | if length > 100 then .[:99] + "…" else . end)] | @tsv' <<<"$answer" | table
  echo
  echo "Run one: $(cmd "nicetrybot call TOOL key=value…")   (add $(cmd --json) for its whole answer)"
}

# call TOOL key=value… or call TOOL '{"key": …}': a value that reads as JSON (a number, true, a list)
# goes as that, anything else as a string.
cmd_call() {
  [[ $# -gt 0 ]] || fail "$(cmd "nicetrybot call TOOL [key=value…]") ($(cmd "nicetrybot tools") lists them)"
  local tool=$1 arguments='{}' pair
  shift
  for pair in "$@"; do
    if [[ $pair == '{'* ]]; then
      arguments=$(jq -c --argjson more "$pair" '. + $more' <<<"$arguments" 2>/dev/null) || fail "That isn't JSON: $pair"
    elif [[ $pair == *=* ]]; then
      arguments=$(jq -c --arg key "${pair%%=*}" --arg value "${pair#*=}" '. + {($key): ($value | fromjson? // $value)}' <<<"$arguments")
    else
      fail "Give the tool's arguments as key=value (got $pair)"
    fi
  done
  app_command
  run_tool "$tool" "$arguments"
}

domains_usage() {
  color_help >&2 <<'USAGE'
nicetrybot domains                     the team's domains
nicetrybot domains add HOST ORIGIN     put HOST behind the edge, forwarding to ORIGIN (like docs-origin.example.com)
    --www                              serve www.HOST too
    --host-header=rewrite              send the origin its own Host (Vapor, Vercel, CloudFront…), not the visitor's
    --origin-host-header=HOST          with rewrite: send this Host instead
    --forwarded-host-header=NAME[,…]   headers that carry the visitor's host, like X-Forwarded-Host
nicetrybot domains check HOST          ownership (verified once its TXT record shows up), the origin lock, DNS, and what's next
nicetrybot domains verify HOST         check its ownership TXT record
nicetrybot domains mode HOST off|observe|enforce
nicetrybot domains secret HOST         the origin secret header the edge sends
nicetrybot domains remove HOST         take it out of NiceTryBot (its request history goes too)
USAGE
  exit 1
}

# DNS records (a JSON list of {type, name, value}) as an indented table.
domain_records() {
  jq -r '.[] | [.type, .name, .value] | @tsv' <<<"$1" | table | sed 's/^/     /'
}

# The origin secret header, and how to lock the origin to it: HOST ORIGIN_URL HEADER VALUE [INDENT].
origin_lock_advice() {
  local hostname=$1 origin=$2 header=$3 value=$4 i=${5:-} origin_host
  origin_host=${origin#*://}
  origin_host=${origin_host%%/*}
  [[ -n $origin_host ]] || origin_host="the origin"
  echo "${i}The edge sends this header with every request to $origin_host:"
  echo
  printf '%s  %s%s%s: %s%s\n' "$i" "$c_yellow" "$c_bold" "$header" "$value" "$c_reset"
  echo
  echo "${i}Put the secret in the origin's environment (like NICETRY_ORIGIN_SECRET, never in git) and have"
  echo "${i}it refuse any request without the header, with a 403. Compare in constant time (hash_equals in"
  echo "${i}PHP, crypto.timingSafeEqual in Node). Until then, anyone who finds the origin can go around the"
  echo "${i}edge, and its rules and gym, to reach the site directly."
  echo
  echo "${i}Then: $(cmd "nicetrybot domains check $hostname") (the origin should refuse a request without the header)"
}

# What domains add answered, as the steps to go live, the origin secret among them.
domain_added() {
  local answer=$1 hostname origin
  if [[ $json_out == true ]]; then
    jq . <<<"$answer"
    return
  fi
  hostname=$(jq -r .hostname <<<"$answer")
  origin=$(jq -r .origin_url <<<"$answer")
  done_ "Added $(link_to "https://$hostname"), forwarding to $origin, in $(jq -r .protection_mode <<<"$answer") mode: $(link_to "$(jq -r .page_url <<<"$answer")")"
  echo
  echo "${c_coral}${c_bold}1.${c_reset} ${c_bold}Prove it's yours:${c_reset} add this record, then run $(cmd "nicetrybot domains check $hostname")"
  echo
  domain_records "$(jq -c '[.ownership_record]' <<<"$answer")"
  echo
  echo "${c_coral}${c_bold}2.${c_reset} ${c_bold}Lock the origin to the edge${c_reset}, so nobody can reach the site around it."
  echo
  origin_lock_advice "$hostname" "$origin" "$(jq -r .origin_secret.header <<<"$answer")" "$(jq -r .origin_secret.value <<<"$answer")" "   "
  echo
  echo "${c_coral}${c_bold}3.${c_reset} ${c_bold}Then point DNS at the edge:${c_reset}"
  echo
  domain_records "$(jq -c .edge_records <<<"$answer")"
}

# A green tick or a red cross, for true or anything else.
mark() {
  if [[ $1 == true ]]; then printf '%s✓%s' "$c_green" "$c_reset"; else printf '%s✗%s' "$c_red" "$c_reset"; fi
}

# What domains check answered, as a checklist: ownership, the origin lock and DNS, with what to do next.
domain_checked() {
  local answer=$1 hostname verified locked pointed preview
  if [[ $json_out == true ]]; then
    jq . <<<"$answer"
    return
  fi
  hostname=$(jq -r .hostname <<<"$answer")
  verified=$(jq -r .ownership.verified <<<"$answer")
  locked=$(jq -r .origin.locked <<<"$answer")
  pointed=$(jq -r .dns.pointed_at_edge <<<"$answer")
  preview=$(jq -r '.preview_url // empty' <<<"$answer")
  echo "${c_bold}$(link_to "https://$hostname")${c_reset} → $(jq -r .origin_url <<<"$answer"), in $(jq -r .protection_mode <<<"$answer") mode"
  echo "  ${c_dim}Panel:${c_reset} $(link_to "$(jq -r .page_url <<<"$answer")")"
  [[ -n $preview ]] && echo "  ${c_dim}Preview, through the edge:${c_reset} $(link_to "$preview")"
  echo
  echo "$(mark "$verified") ${c_bold}Ownership:${c_reset} $(jq -r '.ownership.summary // (if .ownership.verified then "Verified." else "Not verified yet." end)' <<<"$answer")"
  if [[ $verified != true ]]; then
    domain_records "$(jq -c '[.ownership | {type, name, value}]' <<<"$answer")"
  fi
  echo "$(mark "$locked") ${c_bold}Origin locked to the edge:${c_reset} $(jq -r .origin.summary <<<"$answer")"
  if [[ $locked != true ]]; then
    echo "     The header, and how to lock the origin: $(cmd "nicetrybot domains secret $hostname")"
  fi
  echo "$(mark "$pointed") ${c_bold}DNS at the edge:${c_reset} $(jq -r .dns.summary <<<"$answer")"
  if [[ $pointed != true ]]; then
    domain_records "$(jq -c .dns.records <<<"$answer")"
    echo "     Change DNS last, once the domain is verified and its origin locked: visitors then go through the edge."
  fi
  echo
  if [[ $verified != true ]]; then
    next_step "add the TXT record, then $(cmd "nicetrybot domains check $hostname")"
  elif [[ $locked != true ]]; then
    next_step "lock the origin ($(cmd "nicetrybot domains secret $hostname")), then $(cmd "nicetrybot domains check $hostname")"
  elif [[ $pointed != true ]]; then
    next_step "point DNS at the edge with the records above, then $(cmd "nicetrybot domains check $hostname")"
  elif [[ $(jq -r .protection_mode <<<"$answer") != enforce ]]; then
    echo "${c_green}${c_bold}All set:${c_reset} $(link_to "https://$hostname") goes through the edge."
    next_step "watch its traffic for a while, then $(cmd "nicetrybot domains mode $hostname enforce")"
  else
    echo "${c_green}${c_bold}All set:${c_reset} $(link_to "https://$hostname") goes through the edge, which enforces your rules."
  fi
}

cmd_domains() {
  local action=${1:-list}
  [[ $# -gt 0 ]] && shift
  case $action in
    list | ls)
      app_command
      local answer
      answer=$(mcp_tool list-domains) || exit 1
      if [[ $json_out == true ]]; then
        jq . <<<"$answer"
      elif [[ $(jq '.domains | length' <<<"$answer") == 0 ]]; then
        echo "No domains on $(jq -r .team <<<"$answer") yet. Add one: $(cmd "nicetrybot domains add www.example.com www-origin.example.com")"
      else
        {
          printf 'HEADER:HOSTNAME\tMODE\tSTATUS\tDNS\tORIGIN\n'
          jq -r --arg green "$c_green" --arg yellow "$c_yellow" --arg dim "$c_dim" --arg off "$c_reset" '
            def paint($color): $color + . + $off;
            .domains[] | [.hostname + (if .serves_www then " (+www)" else "" end),
              (.protection_mode | paint({enforce: $green, observe: $yellow}[.] // $dim)),
              (.status | paint(if . == "active" then $green else $yellow end)),
              (if .dns_pointed_at_edge then "edge" | paint($green) else "-" end),
              .origin_url] | @tsv' <<<"$answer"
        } | table
      fi
      ;;
    add)
      local hostname='' origin='' www=false host_header='' origin_host_header='' forwarded='' arg
      for arg in "$@"; do
        case $arg in
          --www) www=true ;;
          --host-header=*) host_header=${arg#*=} ;;
          --rewrite | --rewrite-host | --rewrite-to-origin-host) host_header=rewrite ;;
          --origin-host-header=*) origin_host_header=${arg#*=} ;;
          --forwarded-host-header=* | --fwd-host-header=*) forwarded="${forwarded:+$forwarded,}${arg#*=}" ;;
          -*) fail "domains add doesn't know $arg ($(cmd "nicetrybot domains help"))" ;;
          *)
            if [[ -z $hostname ]]; then
              hostname=$arg
            elif [[ -z $origin ]]; then
              origin=$arg
            else
              fail "domains add HOST ORIGIN (got another: $arg)"
            fi
            ;;
        esac
      done
      [[ -n $hostname && -n $origin ]] || domains_usage
      [[ $origin == *://* ]] || origin="https://$origin"
      host_header=$(printf '%s' "$host_header" | tr '-' '_')
      app_command
      local answer
      answer=$(mcp_tool add-domain "$(jq -nc --arg hostname "$hostname" --arg origin "$origin" --argjson www "$www" \
        --arg host_header "$host_header" --arg origin_host_header "$origin_host_header" --arg forwarded "$forwarded" \
        '{hostname: $hostname, origin_url: $origin, serves_www: $www}
          + (if $host_header != "" then {host_header_mode: $host_header} else {} end)
          + (if $origin_host_header != "" then {origin_host_header: $origin_host_header} else {} end)
          + (if $forwarded != "" then {forwarded_host_header: $forwarded} else {} end)')") || exit 1
      domain_added "$answer"
      ;;
    secret)
      [[ $# -eq 1 ]] || domains_usage
      app_command
      local answer
      answer=$(mcp_tool get-origin-secret "$(jq -nc --arg hostname "$1" '{hostname: $hostname}')") || exit 1
      if [[ $json_out == true ]]; then
        jq . <<<"$answer"
      else
        origin_lock_advice "$1" "$(jq -r '.origin_url // empty' <<<"$answer")" "$(jq -r .header <<<"$answer")" "$(jq -r .value <<<"$answer")"
      fi
      ;;
    check | show)
      [[ $# -eq 1 ]] || domains_usage
      app_command
      local answer
      answer=$(mcp_tool check-domain "$(jq -nc --arg hostname "$1" '{hostname: $hostname}')") || exit 1
      domain_checked "$answer"
      ;;
    verify | remove | rm | delete)
      [[ $# -eq 1 ]] || domains_usage
      local tool
      case $action in
        verify) tool=verify-domain ;;
        *) tool=remove-domain ;;
      esac
      app_command
      if [[ $tool == remove-domain ]]; then
        confirm "Remove $1${app_remote:+ on $app_remote}? The edge stops serving it, and its request history is deleted." || fail "Nothing removed."
      fi
      run_tool "$tool" "$(jq -nc --arg hostname "$1" '{hostname: $hostname}')"
      ;;
    mode | protection)
      [[ $# -eq 2 ]] || domains_usage
      app_command
      run_tool set-protection-mode "$(jq -nc --arg hostname "$1" --arg mode "$2" '{hostname: $hostname, mode: $mode}')"
      ;;
    help | --help | -h) domains_usage ;;
    *) domains_usage ;;
  esac
}

# rules|gyms [list] [ID], rules|gyms remove ID: the area's list and delete tools.
cmd_listed() {
  local noun=$1 singular=$2 action=${3:-list}
  [[ $# -ge 3 ]] && shift 3 || shift 2
  case $action in
    list | ls)
      app_command
      run_tool "list-$noun"
      ;;
    remove | rm | delete)
      [[ $# -eq 1 && $1 =~ ^[0-9]+$ ]] || fail "nicetrybot $noun remove ID (the id from nicetrybot $noun)"
      app_command
      confirm "Delete $singular $1${app_remote:+ on $app_remote}?" || fail "Nothing deleted."
      run_tool "delete-$singular" "{\"id\": $1}"
      ;;
    [0-9]*)
      [[ $noun == rules ]] || fail "nicetrybot $noun [list|remove ID]"
      app_command
      run_tool list-rules "{\"id\": $action}"
      ;;
    *) fail "nicetrybot $noun [list|remove ID]" ;;
  esac
}

# --- Remotes ------------------------------------------------------------------------------------

# Ask the panel who a token is (whoami, or list-domains on a release before it), on TEAM (a slug) when
# given. Prints, tab-separated: the team's name, when the token expires (seconds since 1970, or empty
# for never), the team's slug, yes for a token for all teams, and those teams' slugs.
token_details() {
  local url=$1 api_token=$2 team=${3:-} arguments='{}' answer
  [[ -n $team ]] && arguments=$(jq -nc --arg team "$team" '{team: $team}')
  answer=$(mcp_post "$url" "$api_token" tools/call whoami "$(mcp_body tools/call "$(jq -nc --argjson arguments "$arguments" '{name: "whoami", arguments: $arguments}')")") || exit 1
  if [[ $(jq -r '.error.message // empty' <<<"$answer") == *'not found'* ]]; then
    answer=$(mcp_post "$url" "$api_token" tools/call list-domains "$(mcp_body tools/call '{"name": "list-domains", "arguments": {}}')") || exit 1
  fi
  [[ -n $(jq -r '.error.message // empty' <<<"$answer") ]] && fail "$url: $(jq -r .error.message <<<"$answer")"
  [[ $(jq -r '.result.isError // false' <<<"$answer") == true ]] && fail "$(jq -r '[.result.content[]? | .text // empty] | join("\n")' <<<"$answer")"
  jq -r '.result.structuredContent
    | [(.team | if type == "object" then .name elif . == null then "" else . end),
       (.expires_at // "" | if . == "" then "" else (capture("^(?<at>.{19})(?<sign>[+-])(?<h>\\d\\d):?(?<m>\\d\\d)$") as $t
          | ($t.at + "Z" | fromdateiso8601) - ($t.sign + "1" | tonumber) * (($t.h | tonumber) * 3600 + ($t.m | tonumber) * 60)) end),
       (.team | if type == "object" then .slug else "" end),
       (if .all_teams then "yes" else "no" end),
       ((.teams // []) | map(.slug) | join(", "))]
    | @tsv' <<<"$answer"
}

# For a token for all teams with no team picked yet: the details on PREVIOUS (the team the remote used
# before) while the token still reaches it, or on the only team there is. Prints the details to use.
settle_team() {
  local url=$1 api_token=$2 details=$3 previous=${4:-} teams
  teams=$(cut -f5 <<<"$details")
  if [[ $(cut -f4 <<<"$details") != yes || -n $(cut -f3 <<<"$details") ]]; then
    printf '%s\n' "$details"
  elif [[ -n $previous && ", $teams, " == *", $previous, "* ]]; then
    token_details "$url" "$api_token" "$previous"
  elif [[ -n $teams && $teams != *,* ]]; then
    token_details "$url" "$api_token" "$teams"
  else
    printf '%s\n' "$details"
  fi
}

# After saving a token for all teams with no team picked: say how to pick one.
say_pick_team() {
  [[ $(remote_get "$1" all_teams) == yes && -z $(remote_get "$1" team_slug) ]] || return 0
  echo "Its token works on all your teams ($2)."
  next_step "pick the one to work on: $(cmd "nicetrybot team use SLUG")"
}

# The token for a remote: --token, or asked for (hidden) on the terminal.
read_api_token() {
  local url=$1 value=$token
  if [[ -z $value ]]; then
    [[ -r /dev/tty ]] || fail "Give the API token with --token=ntb_… (no terminal to ask on)"
    echo "Make a token at $(link_to "${url%/}/admin/tokens") (pick its abilities and how long it lasts)." >&2
    read -r -s -p "API token: " value </dev/tty || fail "No token given."
    echo >&2
  fi
  value=$(printf '%s' "$value" | tr -d '[:space:]')
  looks_like_api_token "$value" || fail "An API token starts with ntb_ and has 48 letters and digits after it."
  printf '%s' "$value"
}

save_remote() {
  local name=$1 url=$2 api_token=$3 details=$4
  mkdir -p "$remotes"
  chmod 700 "$config_dir" "$remotes"
  (
    umask 077
    printf 'url=%s\ntoken=%s\nteam=%s\nteam_slug=%s\nall_teams=%s\nexpires=%s\n' "$url" "$api_token" \
      "$(cut -f1 <<<"$details")" "$(cut -f3 <<<"$details")" "$(cut -f4 <<<"$details")" "$(cut -f2 <<<"$details")" >"$remotes/$name.tmp"
  )
  mv -f "$remotes/$name.tmp" "$remotes/$name"
}

use_remote() {
  mkdir -p "$config_dir"
  printf '%s\n' "$1" >"$current_remote_file"
}

expiry() {
  local expires=$1 left
  [[ -n $expires ]] || {
    echo "never expires"
    return 0
  }
  left=$((expires - $(date +%s)))
  if ((left <= 0)); then
    echo "${c_red}expired:${c_reset} $(cmd "nicetrybot remote auth")"
  elif ((left < 3600)); then
    echo "expires in $((left / 60)) min"
  elif ((left < 172800)); then
    echo "expires in $(((left + 1800) / 3600)) h"
  else
    echo "expires in $(((left + 43200) / 86400)) days"
  fi
}

remote_add() {
  local name url api_token details
  case $# in
    1)
      url=$(panel_url "$1") || exit 1
      name=${url#*://} name=${name%%:*}
      ;;
    2)
      name=$1
      url=$(panel_url "$2") || exit 1
      ;;
    *) fail "$(cmd "nicetrybot remote add [NAME] URL"), like: $(cmd "nicetrybot remote add prod app.example.com")" ;;
  esac
  valid_remote_name "$name" || fail "A remote's name is letters, digits, dots, dashes and underscores (got $name)"
  [[ -f $remotes/$name ]] && fail "There's already a remote called $name ($(remote_get "$name" url)): $(cmd "nicetrybot remote auth $name") gives it a new token"
  api_token=$(read_api_token "$url") || exit 1
  details=$(token_details "$url" "$api_token") || exit 1
  details=$(settle_team "$url" "$api_token" "$details") || exit 1
  save_remote "$name" "$url" "$api_token" "$details"
  use_remote "$name"
  done_ "Saved $name ($url), $(remote_team "$name"), $(expiry "$(cut -f2 <<<"$details")"). It's the current remote."
  say_pick_team "$name" "$(cut -f5 <<<"$details")"
}

cmd_remote() {
  local action=${1:-}
  [[ $# -gt 0 ]] && shift
  case $action in
    '')
      if [[ -s $current_remote_file && -f $remotes/$(cat "$current_remote_file") ]]; then
        local name
        name=$(cat "$current_remote_file")
        echo "Current remote: $name ($(remote_get "$name" url)), $(remote_team "$name"), $(expiry "$(remote_get "$name" expires)")"
      elif [[ -f $dir/compose.yml ]]; then
        echo "No current remote: the app's commands run on this server ($dir)."
      else
        echo "No remote yet. Add your panel: $(cmd "nicetrybot remote add app.example.com")"
      fi
      ;;
    add) need_jq && remote_add "$@" ;;
    list | ls)
      if ! ls "$remotes"/* >/dev/null 2>&1; then
        echo "No remotes yet. Add your panel: $(cmd "nicetrybot remote add app.example.com")"
        return 0
      fi
      local file name team current=''
      [[ -s $current_remote_file ]] && current=$(cat "$current_remote_file")
      {
        printf 'HEADER: \tNAME\tURL\tTEAM\tTOKEN\n'
        for file in "$remotes"/*; do
          [[ -f $file ]] || continue
          name=${file##*/}
          team=$(remote_get "$name" team)
          if [[ $(remote_get "$name" all_teams) == yes ]]; then
            team="${team:--} (all teams)"
          fi
          printf '%s\t%s\t%s\t%s\t%s\n' "$([[ $name == "$current" ]] && echo "${c_green}*${c_reset}" || echo ' ')" "$name" "$(remote_get "$name" url)" "$team" "$(expiry "$(remote_get "$name" expires)")"
        done
      } | table
      ;;
    use | switch)
      if [[ $use_local == true ]]; then
        rm -f "$current_remote_file"
        done_ "The app's commands run on this server again."
        return 0
      fi
      [[ $# -eq 1 ]] || fail "$(cmd "nicetrybot remote use NAME") (or $(cmd --local), for this server)"
      [[ -f $remotes/$1 ]] || fail "No remote called $1 ($(cmd "nicetrybot remote list"))"
      use_remote "$1"
      done_ "Using $1 ($(remote_get "$1" url)), $(remote_team "$1")."
      ;;
    auth | login | token)
      need_jq
      local name=${1:-}
      [[ -n $name ]] || name=$(cat "$current_remote_file" 2>/dev/null || true)
      [[ -n $name && -f $remotes/$name ]] || fail "$(cmd "nicetrybot remote auth NAME") ($(cmd "nicetrybot remote list"))"
      local url api_token details
      url=$(remote_get "$name" url)
      api_token=$(read_api_token "$url") || exit 1
      details=$(token_details "$url" "$api_token") || exit 1
      details=$(settle_team "$url" "$api_token" "$details" "$(remote_get "$name" team_slug)") || exit 1
      save_remote "$name" "$url" "$api_token" "$details"
      done_ "$name has its new token: $(remote_team "$name"), $(expiry "$(cut -f2 <<<"$details")")."
      say_pick_team "$name" "$(cut -f5 <<<"$details")"
      ;;
    remove | rm | forget)
      [[ $# -eq 1 ]] || fail "$(cmd "nicetrybot remote remove NAME")"
      [[ -f $remotes/$1 ]] || fail "No remote called $1 ($(cmd "nicetrybot remote list"))"
      local url
      url=$(remote_get "$1" url)
      rm -f "$remotes/$1"
      [[ $(cat "$current_remote_file" 2>/dev/null || true) == "$1" ]] && rm -f "$current_remote_file"
      done_ "Forgot $1. Its token still works until it expires: delete it at $(link_to "${url%/}/admin/tokens") to stop it now."
      ;;
    help | --help | -h) fail "$(cmd "nicetrybot remote [add [NAME] URL | list | use NAME | auth [NAME] | remove NAME | URL]")" ;;
    *)
      # nicetrybot remote NAME|URL: switch to a saved remote, or save a new one.
      [[ $# -eq 0 ]] || fail "$(cmd "nicetrybot remote [add [NAME] URL | list | use NAME | auth [NAME] | remove NAME | URL]")"
      if [[ -f $remotes/$action ]]; then
        use_remote "$action"
        done_ "Using $action ($(remote_get "$action" url)), $(remote_team "$action")."
        return 0
      fi
      local url file
      url=$(panel_url "$action") || exit 1
      for file in "$remotes"/*; do
        [[ -f $file && $(remote_get "${file##*/}" url) == "$url" ]] || continue
        use_remote "${file##*/}"
        done_ "Using ${file##*/} ($url), $(remote_team "${file##*/}")."
        return 0
      done
      need_jq
      remote_add "$url"
      ;;
  esac
}

# --- The command itself -------------------------------------------------------------------------

# The file this command runs from, through any symlinks (macOS's readlink has no -f).
cli_path() {
  local path=${BASH_SOURCE[0]} link
  while [[ -L $path ]]; do
    link=$(readlink "$path")
    if [[ $link == /* ]]; then path=$link; else path="$(dirname "$path")/$link"; fi
  done
  printf '%s/%s' "$(cd "$(dirname "$path")" && pwd -P)" "$(basename "$path")"
}

cli_show_version() {
  local latest
  if [[ $cli_version == dev ]]; then
    echo "nicetrybot command: a development copy, not from a release ($(cli_path))"
  else
    echo "nicetrybot command v$cli_version"
  fi
  latest=$(latest_version || true)
  if [[ -z $latest ]]; then
    echo "Couldn't reach $NICETRY_RELEASE_BASE to find the newest release."
  elif [[ $latest == "$cli_version" ]]; then
    echo "That's the newest release."
  elif [[ $cli_version == dev ]]; then
    echo "The newest release is v$latest. This copy follows its repository: git pull keeps it current."
  else
    echo "${c_yellow}v$latest is out:${c_reset} $(link_to "$(notes_url "$latest")")   Update this command: $(cmd "nicetrybot cli update")"
  fi
}

# Swap this file for the release's copy: downloaded beside it, checked to be a whole script that
# parses, then moved over it in one step (the running copy keeps reading the old file).
cli_update() {
  local path folder wanted work
  path=$(cli_path)
  folder=$(dirname "$path")
  if [[ -n $target ]]; then
    valid_version "$target" || fail "--version takes a release like v1.2.0 (got $target)"
    wanted=$(bare "$target")
  else
    wanted=$(latest_version) || fail "Couldn't find the newest release at $NICETRY_RELEASE_BASE"
  fi
  if [[ $cli_version == "$wanted" ]]; then
    done_ "The nicetrybot command is already v$wanted."
    return 0
  fi
  [[ $cli_version != dev || $assume_yes == true ]] ||
    fail "$path is a development copy, not from a release. --yes replaces it with v$wanted anyway."
  [[ -w $folder && (! -e $path || -w $path) ]] || fail "Can't write to $path: $(cmd "sudo nicetrybot cli update")"

  say "Downloading the nicetrybot command from v$wanted"
  work="$folder/.nicetrybot.download.$$"
  if ! curl -fsSL --retry 3 -o "$work" "$NICETRY_RELEASE_BASE/download/v$wanted/nicetrybot"; then
    rm -f "$work"
    fail "Couldn't download it from $NICETRY_RELEASE_BASE/download/v$wanted/nicetrybot (releases before 0.2.0 don't have it)"
  fi
  if [[ $(head -n 1 "$work") != '#!/usr/bin/env bash' ]] || ! grep -q '^# nicetrybot: ' "$work" || ! bash -n "$work" 2>/dev/null; then
    rm -f "$work"
    fail "What came back for v$wanted isn't the nicetrybot command, so nothing changed."
  fi
  chmod 755 "$work"
  mv -f "$work" "$path"
  local from="v$cli_version"
  [[ $cli_version == dev ]] && from="a development copy"
  done_ "Updated the nicetrybot command: $from → v$wanted ($path)"
  [[ -f $dir/compose.yml ]] && echo "On this server, $(cmd "nicetrybot update") brings NiceTryBot itself up to date too."
  return 0
}

cmd_cli() {
  local action=${1:-version}
  case $action in
    version | --version | -v) cli_show_version ;;
    update | upgrade | self-update) cli_update ;;
    *) fail "$(cmd "nicetrybot cli [version | update [--version=vX.Y.Z]]")" ;;
  esac
}

# --- Main ---------------------------------------------------------------------------------------

command=${1:-help}
[[ $# -gt 0 ]] && shift

args=()
for arg in "$@"; do
  case $arg in
    --yes | -y) assume_yes=true ;;
    --no-backup) backup=false ;;
    --version=*) target=${arg#*=} ;;
    --token=*) token=${arg#*=} ;;
    --remote=*) remote_opt=${arg#*=} ;;
    --local) use_local=true ;;
    --team=*) team_opt=${arg#*=} ;;
    --json) json_out=true ;;
    *) args+=("$arg") ;;
  esac
done
set -- ${args[@]+"${args[@]}"}

case $command in
  update | upgrade) cmd_update ;;
  rollback) cmd_rollback ;;
  apply | restart) cmd_apply ;;
  addons | addon) cmd_addons "$@" ;;
  doctor | health | check) cmd_doctor ;;
  status) cmd_status ;;
  version | --version | -v) cmd_version ;;
  cli) cmd_cli "$@" ;;
  self-update) cli_update ;;
  logs | log) cmd_logs "$@" ;;
  artisan) cmd_artisan "$@" ;;
  remote | remotes) cmd_remote "$@" ;;
  whoami) cmd_whoami ;;
  teams) cmd_teams ;;
  team) cmd_team "$@" ;;
  domains | domain) cmd_domains "$@" ;;
  rules | rule) cmd_listed rules rule "$@" ;;
  gyms | gym) cmd_listed gyms gym "$@" ;;
  tools) cmd_tools ;;
  call) cmd_call "$@" ;;
  # nicetrybot add domain … / remove domain …, as well as domains add / remove.
  add | remove | rm)
    [[ ${1:-} == domain || ${1:-} == domains ]] || fail "$(cmd "nicetrybot $command domain …") (or $(cmd "nicetrybot help"))"
    shift
    cmd_domains "$command" "$@"
    ;;
  help | --help | -h) usage ;;
  *) fail "Unknown command: $command (try: $(cmd "nicetrybot help"))" ;;
esac
