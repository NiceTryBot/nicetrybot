}

cmd_logs() {
  require_stack
  compose logs -f --tail 100 "$@"
}

cmd_artisan() {
  require_stack
  [[ $# -gt 0 ]] || set -- list
  if [[ -t 0 && -t 1 ]]; then
    compose exec app php artisan "$@"
  else
    compose exec -T app php artisan "$@"
  fi
