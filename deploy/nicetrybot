#!/usr/bin/env bash
#
# nicetrybot: look after a self-hosted NiceTryBot from the command line. The installer puts it in
# /usr/local/bin, and each update brings the release's newest copy. On a laptop (macOS or Linux, with
# curl and jq) it runs the app's commands on any NiceTryBot panel: a remote.
#
#   nicetrybot update              update to the newest release (the database is backed up first)
#   nicetrybot update --version=X  update (or go back) to release X, like v1.3.0
#   nicetrybot rollback            put back the release and database from before the last update
#   nicetrybot addons              list the marketplace add-ons built into the app
#   nicetrybot addons add NAME…    build add-ons in, like captchas or nicetry/captchas; NAME=KEY also
#                                  enters its licence key (Your licences on nicetrybot.com builds this)
#   nicetrybot addons remove NAME…
#                                  take add-ons out
#   nicetrybot addons keys         enter the licence keys paid add-ons still need
#   nicetrybot apply               start the stack again with what you changed in .env
#   nicetrybot doctor              check the server, the containers, the panel and the app, with advice
#   nicetrybot status              the release, the containers and the add-ons
#   nicetrybot version             the release running, and the newest one
#   nicetrybot cli update          update this command itself to the newest release (--version=X for
#                                  another); on a server, nicetrybot update updates it with the stack
#   nicetrybot cli version         this command's release, and the newest one
#   nicetrybot logs [SERVICE]      follow the logs (app, worker, scheduler, edge, vector, postgres, valkey)
#   nicetrybot artisan COMMAND…    run an Artisan command in the app, like admin:grant you@example.com
#
# The app, on this server or on the current remote:
#   nicetrybot whoami              the team, user and abilities the commands act with
#   nicetrybot teams               the teams the remote's token works on (* marks the one in use)
#   nicetrybot team use SLUG       switch team, with a token for all your teams (--team=SLUG: one command)
#   nicetrybot domains             the team's domains
#   nicetrybot domains add HOST ORIGIN [--www] [--host-header=rewrite] [--forwarded-host-header=NAME]
#                                  put HOST behind the edge, forwarding to ORIGIN (domains help: more)
#   nicetrybot domains check|verify|secret|remove HOST
#   nicetrybot domains mode HOST off|observe|enforce
#   nicetrybot rules [ID]          the team's rules; rules remove ID deletes one
#   nicetrybot gyms                the team's gyms; gyms remove ID deletes one
#   nicetrybot tools               every tool the token may use, which any of these call
#   nicetrybot call TOOL [key=value…]  call one, like: nicetrybot call query-traffic group_by=country
#
# Remotes: panels the app's commands run on, each with an API token from its Admin → API tokens
# (saved in ~/.config/nicetrybot/remotes, readable only by you):
#   nicetrybot remote add [NAME] URL   save a panel, like app.example.com, and make it the current one
#   nicetrybot remote NAME|URL         switch to a saved remote (or save a new one)
#   nicetrybot remote list             the saved remotes; * marks the current one
#   nicetrybot remote use NAME         make NAME current (remote use --local: back to this server)
#   nicetrybot remote auth [NAME]      give a remote a new token (they expire)
#   nicetrybot remote remove NAME      forget a remote
#
# Options:
#   --yes          don't ask before a rollback, or before removing a domain, rule or gym
#   --no-backup    update without backing up the database first (then rollback can't restore it)
#   --token=TOKEN  with addons add: the Composer token from your account on nicetrybot.com; with
#                  remote add or auth: the API token (asked for otherwise, which keeps it out of history)
#   --remote=NAME  run an app command on that remote rather than the current one
#   --local        run an app command on this server's stack, even with a current remote
#   --team=SLUG    the team to work on: on a remote with a token for all teams, for this command only;
#                  on this server, the first administrator's when left out
#   --json         print the app's answer as JSON
#
# The stack lives in /opt/nicetrybot, or NICETRY_DIR (set in /etc/default/nicetrybot by the installer
# when it was put somewhere else). Each update keeps what it replaced in <dir>/.updates and the
# database's backup in <dir>/backups (the newest three), and logs Docker's output to
# <dir>/.updates/update.log.

set -euo pipefail

[[ -r /etc/default/nicetrybot ]] && . /etc/default/nicetrybot

dir=${NICETRY_DIR:-/opt/nicetrybot}
NICETRY_RELEASE_BASE="${NICETRY_RELEASE_BASE:-https://github.com/NiceTryBot/nicetrybot/releases}"
updates=$dir/.updates
backups=$dir/backups
log=$updates/update.log
keep_backups=3

# The release this copy of the command came from: the release workflow writes it in. "dev" is a copy
# from the repository.
cli_version=dev

assume_yes=false
backup=true
token=
target=

# Colors, on a terminal only: pipes, logs and NO_COLOR (https://no-color.org) get plain text.
if [[ -t 1 && -z ${NO_COLOR:-} && ${TERM:-} != dumb ]]; then
  c_bold=$'\033[1m' c_dim=$'\033[90m' c_red=$'\033[31m' c_green=$'\033[32m' c_yellow=$'\033[33m'
  c_cyan=$'\033[36m' c_coral=$'\033[38;5;203m' c_link=$'\033[4m' c_reset=$'\033[0m'
else
  c_bold='' c_dim='' c_red='' c_green='' c_yellow='' c_cyan='' c_coral='' c_link='' c_reset=''
fi

# Text without its colors.
plain() { sed $'s/\033\\[[0-9;]*m//g' <<<"$1"; }

# A command to run, in cyan, and a link, underlined, inside a message.
cmd() { printf '%s%s%s' "$c_cyan" "$*" "$c_reset"; }
link_to() { printf '%s%s%s' "$c_link" "$*" "$c_reset"; }

# What to do next, after a coral "Next:".
next_step() { printf '%s%sNext:%s %s\n' "$c_coral" "$c_bold" "$c_reset" "$*"; }

say() { printf '%s%s==>%s %s%s%s\n' "$c_coral" "$c_bold" "$c_reset" "$c_bold" "$*" "$c_reset"; }
done_() { printf '%s✓%s %s\n' "$c_green" "$c_reset" "$*"; }
warn() { to_stderr "${c_yellow}${c_bold}Warning:${c_reset} $*"; }
fail() {
  to_stderr "${c_red}${c_bold}Error:${c_reset} $*"
  exit 1
}

# A message on standard error, in color while that's a terminal too.
to_stderr() {
  if [[ -t 2 ]]; then printf '%s\n' "$1" >&2; else plain "$1" >&2; fi
}

usage() {
  banner
  sed -n '2,/^$/{s/^# \{0,1\}//;p;}' "$0" | color_help
}

# Help text with its commands and options in cyan and its headings in bold.
color_help() {
  sed -E -e "s/^( *)(nicetrybot [^ ]+( [^ ]+)*)(  |\$)/\\1${c_cyan}\\2${c_reset}\\4/" \
    -e "s/^(  )(--[a-z-]+(=[A-Z]+)?)/\\1${c_cyan}\\2${c_reset}/" \
    -e "s/^([A-Z][^ ].*:)\$/${c_bold}\\1${c_reset}/"
}

# The installer's NiceTryBot, "Bot" in coral, on a terminal only: scripts and logs get just the steps.
banner() {
  [[ -t 1 ]] || return 0
  local line
  local lines=(
    ' _   _ _          _____           ____        _   '
    '| \ | (_) ___ ___|_   _| __ _   _| __ )  ___ | |_ '
    "|  \\| | |/ __/ _ \\ | || '__| | | |  _ \\ / _ \\| __|"
    '| |\  | | (_|  __/ | || |  | |_| | |_) | (_) | |_ '
    '|_| \_|_|\___\___| |_||_|   \__, |____/ \___/ \__|'
    '                            |___/                 '
  )
  echo
  for line in "${lines[@]}"; do
    printf '  %s%s%s%s%s\n' "$c_bold" "${line:0:33}" "$c_coral" "${line:33}" "$c_reset"
  done
  echo
}

# --- Helpers ------------------------------------------------------------------------------------

env_get() { sed -n "s/^$2=//p" "$1" | tail -n 1; }

# Set KEY=VALUE in an env file, in place of an existing KEY= line or at the end.
env_set() {
  local file=$1 key=$2 value=$3
  KEY=$key VALUE=$value awk '
    BEGIN { key = ENVIRON["KEY"]; value = ENVIRON["VALUE"]; done = 0 }
    index($0, key "=") == 1 { print key "=" value; done = 1; next }
    { print }
    END { if (!done) print key "=" value }
  ' "$file" >"$file.tmp"
  cat "$file.tmp" >"$file"
  rm -f "$file.tmp"
}

compose() { docker compose "$@"; }

elapsed() {
  local s=$SECONDS
  if ((s >= 60)); then printf '%dm %02ds' $((s / 60)) $((s % 60)); else printf '%ds' "$s"; fi
}

confirm() {
  [[ $assume_yes == true ]] && return 0
  [[ -r /dev/tty ]] || fail "$1 Add --yes to go ahead without a terminal."
  local answer
  read -r -p "$1 [y/N] " answer </dev/tty || return 1
  [[ $answer =~ ^[Yy] ]]
}

# The stack's folder, with its .env, and a Docker this user may run.
require_stack() {
  [[ -f $dir/.env && -f $dir/compose.yml ]] ||
    fail "There's no NiceTryBot in $dir. Install it: curl -fsSL https://nicetrybot.com/install.sh | sudo bash"
  docker info >/dev/null 2>&1 || fail "Docker isn't running, or this user can't use it: run it as root (sudo nicetrybot …)."
  cd "$dir"
  mkdir -p "$updates"
}

# Seconds since 1970 for a date like openssl's "Jan  5 12:00:00 2027 GMT": GNU date, or BSD date on a Mac.
epoch() { date -d "$1" +%s 2>/dev/null || date -j -f '%b %e %T %Y %Z' "$1" +%s; }

bare() { printf '%s' "${1#v}"; }
valid_version() { [[ $1 =~ ^v?[0-9]+\.[0-9]+\.[0-9]+(-[0-9A-Za-z][0-9A-Za-z.-]*)?$ ]]; }

# The release the app is running, from its image's label (an add-ons image keeps its release's), or
# NICETRY_VERSION when it isn't running.
running_version() {
  local app version=''
  app=$(compose ps -q app 2>/dev/null || true)
  if [[ -n $app ]]; then
    version=$(docker inspect -f '{{index .Config.Labels "org.opencontainers.image.version"}}' "$app" 2>/dev/null || true)
  fi
  if [[ -z $version || $version == '<no value>' ]]; then
    version=$(env_get .env NICETRY_VERSION)
    [[ $version == latest ]] && version=''
  fi
  printf '%s' "$version"
}

# The newest release, from where GitHub's latest-release link points (no API, no rate limit).
latest_version() {
  local location
  location=$(curl -fsS -m 10 -o /dev/null -w '%{redirect_url}' "$NICETRY_RELEASE_BASE/latest" 2>/dev/null || true)
  location=${location##*/tag/}
  valid_version "$location" && bare "$location"
}

notes_url() { printf '%s/tag/v%s' "$NICETRY_RELEASE_BASE" "$1"; }

fetch() {
  local version=$1 name=$2 target=$3
  curl -fsSL --retry 3 -o "$target" "$NICETRY_RELEASE_BASE/download/v$version/$name" ||
    fail "Couldn't download $name for v$version from $NICETRY_RELEASE_BASE/download/v$version/$name"
}

addons_list() { env_get .env NICETRY_ADDONS | tr -d '"'"'" | xargs; }

# Bring compose.addons.yml in when NICETRY_ADDONS lists any (the app's image is built here with them),
# and take it out when it doesn't, as the installer does.
apply_addons_file() {
  local compose_file
  compose_file=$(env_get .env COMPOSE_FILE)
  if [[ -z $(addons_list) ]]; then
    [[ $compose_file == compose.yml:compose.addons.yml ]] && env_set .env COMPOSE_FILE compose.yml
    return 0
  fi
  [[ -n $(env_get .env NICETRY_COMPOSER_TOKEN) ]] ||
    fail "NICETRY_ADDONS lists add-ons, but NICETRY_COMPOSER_TOKEN in $dir/.env is empty. Make a Composer token on your account at nicetrybot.com, then: $(cmd "nicetrybot addons add --token=TOKEN")"
  case $compose_file in
    '' | compose.yml) env_set .env COMPOSE_FILE compose.yml:compose.addons.yml ;;
    *compose.addons.yml*) ;;
    *) warn "COMPOSE_FILE in $dir/.env is $compose_file; add :compose.addons.yml to it, or the add-ons won't be built in." ;;
  esac
}

# The release's app image, which the add-ons' image is built on.
base_image() {
  local image version
  image=$(env_get .env NICETRY_APP_IMAGE)
  version=$(env_get .env NICETRY_VERSION)
  printf '%s' "${image:-ghcr.io/nicetrybot/app:${version:-latest}}"
}

# Pull the release's images (and the add-ons' base), build the add-ons in if any, and start what
# changed. Docker's output goes to the log. With "keep", an add-ons image this server already has for
# the release is used as it is (going back), rather than built again.
#
# Only the app's image is ever built here (compose build app): compose.yml also says how to build the
# edge and Vector from their source, for development, and `up --build` would try that too and fail.
# The release's edge and Vector images are pulled instead.
failed_step=
start_stack() {
  local mode=${1:-build}
  failed_step=
  {
    echo "--- $(date -u '+%F %T') up (NICETRY_VERSION=$(env_get .env NICETRY_VERSION), add-ons: $(addons_list))"
    compose pull --quiet --ignore-pull-failures || true
  } >>"$log" 2>&1
  if [[ -n $(addons_list) ]]; then
    if [[ $mode == keep ]] && docker image inspect "nicetrybot-app-addons:$(env_get .env NICETRY_VERSION)" >/dev/null 2>&1; then
      echo "Using the add-ons image this server already has" >>"$log"
    else
      docker pull --quiet "$(base_image)" >>"$log" 2>&1 || warn "Couldn't pull $(base_image); building on the copy this server has."
      say "Building the add-ons in (a few minutes)"
      compose build app >>"$log" 2>&1 || {
        failed_step="Building the app's image with the add-ons"
        return 1
      }
    fi
  fi
  compose up -d --remove-orphans >>"$log" 2>&1 || {
    failed_step="Starting the stack"
    return 1
  }
}

wait_healthy() {
  local app status
  for _ in $(seq 1 120); do
    app=$(compose ps -q app 2>/dev/null || true)
    status=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{end}}' "$app" 2>/dev/null || true)
    [[ $status == healthy ]] && return 0
    sleep 5
  done
  return 1
}

show_log_tail() {
  echo >&2
  tail -n 30 "$log" >&2 || true
  compose logs --tail 30 app >&2 2>/dev/null || true
}

# --- The database ---------------------------------------------------------------------------------

# Only the bundled Postgres is backed up and restored here; a managed one has its own backups.
bundled_postgres() { [[ -n $(compose ps -q postgres 2>/dev/null || true) ]]; }

psql_() { compose exec -T postgres sh -c 'psql -q -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" "$@"' psql "$@"; }

migration_count() {
  bundled_postgres || return 0
  psql_ -tAc 'select count(*) from migrations' 2>/dev/null | tr -d '[:space:]' || true
}

# Back the database up to backups/<when>-v<release>.sql.gz, keeping the newest few; prints the path.
backup_database() {
  local version=$1 file
  mkdir -p "$backups"
  chmod 700 "$backups"
  file=$backups/$(date -u +%Y%m%d-%H%M%S)-v${version:-unknown}.sql.gz
  compose exec -T postgres sh -c 'pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" --no-owner' | gzip >"$file.partial" ||
    {
      rm -f "$file.partial"
      return 1
    }
  mv -f "$file.partial" "$file"
  chmod 600 "$file"
  ls -1t "$backups"/*.sql.gz 2>/dev/null | tail -n +$((keep_backups + 1)) | xargs -r rm -f
  printf '%s' "$file"
}

# Put the database back as the backup has it: the schema is emptied first, so tables a newer
# release made go too.
restore_database() {
  local file=$1
  psql_ -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' >>"$log" 2>&1
  gunzip -c "$file" | psql_ >>"$log" 2>&1
}

# --- Updating -----------------------------------------------------------------------------------

# What an update replaced, for nicetrybot rollback: the stack's files, the release, the add-ons, the
# backup and how many migrations had run.
save_previous() {
  local version=$1 backup_file=$2 migrations=$3
  rm -rf "$updates/previous"
  mkdir -p "$updates/previous"
  cp -f compose.yml "$updates/previous/"
  [[ -f compose.addons.yml ]] && cp -f compose.addons.yml "$updates/previous/"
  {
    printf 'version=%s\n' "$version"
    printf 'compose_file=%s\n' "$(env_get .env COMPOSE_FILE)"
    printf 'addons=%s\n' "$(env_get .env NICETRY_ADDONS)"
    printf 'backup=%s\n' "$backup_file"
    printf 'migrations=%s\n' "$migrations"
    printf 'at=%s\n' "$(date -u '+%F %H:%M UTC')"
  } >"$updates/previous/state"
}

state_get() { env_get "$updates/previous/state" "$1"; }

# The images this server runs as :latest are kept under their release's tag too, so going back to
# that release needs no download (the add-ons' image, built here, couldn't be downloaded at all).
keep_current_images() {
  local version=$1 image
  [[ -n $version ]] || return 0
  for image in nicetrybot-app-addons ghcr.io/nicetrybot/app ghcr.io/nicetrybot/edge ghcr.io/nicetrybot/vector; do
    if docker image inspect "$image:latest" >/dev/null 2>&1 && ! docker image inspect "$image:$version" >/dev/null 2>&1; then
      docker tag "$image:latest" "$image:$version" >>"$log" 2>&1 || true
    fi
  done
}

# Put the release, files and add-ons from before the last update back, and the database when
# restore_db is true.
put_back() {
  local restore_db=$1 version backup_file
  version=$(state_get version)
  backup_file=$(state_get backup)

  cp -f "$updates/previous/compose.yml" compose.yml
  [[ -f $updates/previous/compose.addons.yml ]] && cp -f "$updates/previous/compose.addons.yml" compose.addons.yml
  env_set .env NICETRY_VERSION "$version"
  env_set .env COMPOSE_FILE "$(state_get compose_file)"
  env_set .env NICETRY_ADDONS "$(state_get addons)"

  if [[ $restore_db == true ]]; then
    if [[ -n $backup_file && -f $backup_file ]] && bundled_postgres; then
      say "Restoring the database from $(basename "$backup_file")"
      compose stop app worker scheduler >>"$log" 2>&1 || true
      restore_database "$backup_file" || fail "Restoring the database failed; see $log. The backup is $backup_file."
    else
      warn "No database backup to restore from; the database stays as it is."
    fi
  fi

  say "Starting v$version"
  start_stack keep || {
    show_log_tail
    fail "Couldn't start v$version again; see $log"
  }
  wait_healthy || {
    show_log_tail
    fail "v$version didn't become healthy either; see $log and: $(cmd "nicetrybot logs app")"
  }
  [[ $restore_db == true ]] && compose exec -T app php artisan cache:clear >>"$log" 2>&1 || true
  mv -f "$updates/previous" "$updates/rolled-back-$(date -u +%Y%m%d-%H%M%S)"
}

cmd_update() {
  require_stack
  banner
  SECONDS=0
  local current addons backup_file='' migrations_before migrations_after next=$updates/next

  current=$(running_version)
  if [[ -n $target ]]; then
    valid_version "$target" || fail "--version must be a release like v1.3.0 (got $target)"
    target=$(bare "$target")
  else
    target=$(latest_version) || fail "Couldn't find the newest release at $NICETRY_RELEASE_BASE/latest"
  fi
  addons=$(addons_list)

  if [[ $current == "$target" && -z $addons && $(env_get .env COMPOSE_FILE) != *compose.addons.yml* ]]; then
    done_ "Already on v$target, the newest release. Nothing to update."
    return 0
  fi

  if [[ $current == "$target" ]]; then
    say "Already on v$target; building the add-ons in again for their newest versions"
  else
    say "v${current:-?} → v$target   ($(notes_url "$target"))"
  fi

  rm -rf "$next"
  mkdir -p "$next"
  fetch "$target" compose.yml "$next/compose.yml"
  fetch "$target" compose.addons.yml "$next/compose.addons.yml"
  fetch "$target" env.example "$next/.env.example"
  # Releases before this command came in don't have it: this copy stays then.
  curl -fsSL --retry 3 -o "$next/nicetrybot" "$NICETRY_RELEASE_BASE/download/v$target/nicetrybot" 2>/dev/null || rm -f "$next/nicetrybot"

  migrations_before=$(migration_count)
  if [[ $backup == true ]]; then
    if bundled_postgres; then
      say "Backing up the database"
      backup_file=$(backup_database "$current") || fail "The database backup failed, so nothing was changed. (--no-backup skips it.)"
      echo "    $backup_file ($(du -h "$backup_file" | cut -f1))"
    elif [[ ,$(env_get .env COMPOSE_PROFILES), == *,postgres,* ]]; then
      warn "Postgres isn't running, so there's nothing to back up."
    else
      warn "The database isn't the bundled Postgres, so it isn't backed up here: make sure your provider's backups are on."
    fi
  fi

  keep_current_images "$current"
  save_previous "${current:-$(env_get .env NICETRY_VERSION)}" "$backup_file" "$migrations_before"

  mv -f "$next/compose.yml" compose.yml
  mv -f "$next/compose.addons.yml" compose.addons.yml
  mv -f "$next/.env.example" .env.example
  env_set .env NICETRY_VERSION "$target"
  apply_addons_file

  say "Pulling v$target and restarting"
  if ! start_stack || ! wait_healthy; then
    show_log_tail
    warn "v$target didn't start healthy. Going back to v${current:-the previous release}."
    migrations_after=$(migration_count)
    put_back "$([[ $migrations_after != "$migrations_before" ]] && echo true || echo false)"
    fail "The update to v$target failed and v${current:-the previous release} is running again. Docker's output: $log"
  fi

  migrations_after=$(migration_count)
  if [[ -n $migrations_before && -n $migrations_after ]] && ((migrations_after > migrations_before)); then
    echo "    $((migrations_after - migrations_before)) database migration(s) ran"
  fi

  # A new inode, so a copy of this script that's running carries on reading the old one.
  if [[ -s $next/nicetrybot ]]; then
    install -m 755 "$next/nicetrybot" /usr/local/bin/nicetrybot.new && mv -f /usr/local/bin/nicetrybot.new /usr/local/bin/nicetrybot || true
  fi
  rm -rf "$next"
  docker image prune -f >>"$log" 2>&1 || true

  if [[ $current == "$target" ]]; then
    done_ "Add-ons built in again on v$target in $(elapsed)."
  else
    done_ "Updated to v$target in $(elapsed).   Undo: $(cmd "nicetrybot rollback")"
  fi
}

cmd_rollback() {
  require_stack
  banner
  SECONDS=0
  [[ -f $updates/previous/state ]] || fail "There's no update to roll back."
  local version current backup_file
  version=$(state_get version)
  current=$(running_version)
  backup_file=$(state_get backup)

  if [[ -n $backup_file && -f $backup_file ]]; then
    confirm "Go back to v$version (from v${current:-?}), with the database as it was at $(state_get at)? What changed in the panel since then is lost." ||
      fail "Nothing was changed."
    put_back true
  else
    confirm "Go back to v$version (from v${current:-?})? There's no database backup from the update, so the database stays as it is." ||
      fail "Nothing was changed."
    put_back false
  fi
  done_ "Back on v$version in $(elapsed)."
}

# --- Add-ons ------------------------------------------------------------------------------------

# captchas → nicetry/captchas; nicetry/captchas:^1.2 stays as it is.
addon_package() {
  local name=${1,,}
  [[ $name == all || $name == */* ]] || name=nicetry/$name
  [[ $name == all || $name =~ ^[a-z0-9][a-z0-9_.-]*/[a-z0-9][a-z0-9_.-]*(:[^[:space:]]+)?$ ]] ||
    fail "\"$1\" isn't an add-on like captchas or nicetry/captchas"
  printf '%s' "$name"
}

# Before minutes of building: does the add-ons' Composer repository take the token?
token_error=
check_composer_token() {
  local repository status
  repository=$(env_get .env NICETRY_COMPOSER_URL)
  repository=${repository:-$(env_get .env NICETRY_MARKETPLACE_URL)}
  repository=${repository:-https://nicetrybot.com}
  [[ $repository == */composer ]] || repository=${repository%/}/composer
  status=$(curl -s -o /dev/null -m 15 -w '%{http_code}' -H "Authorization: Bearer $(saved_token)" "$repository/packages.json" || true)
  case $status in
    200) return 0 ;;
    401 | 403)
      token_error="$repository didn't take the Composer token in $dir/.env (revoked, or mistyped). Make a new one at $account_url, then add --token=ntbc_…"
      return 1
      ;;
    *) warn "Couldn't ask $repository about the token (HTTP ${status:-none}); building anyway." ;;
  esac
}

rebuild_addons() {
  local before=$1 list
  SECONDS=0
  apply_addons_file
  list=$(addons_list)
  if [[ -n $list ]] && ! check_composer_token; then
    env_set .env NICETRY_ADDONS "\"$before\""
    apply_addons_file
    fail "$token_error Nothing was changed."
  fi
  if ! start_stack || ! wait_healthy; then
    show_log_tail
    env_set .env NICETRY_ADDONS "\"$before\""
    apply_addons_file
    fail "${failed_step:-Starting the app} failed with the add-ons ${list:-taken out}, so NICETRY_ADDONS is back to \"${before:-}\" and the app runs as it did. Docker's output: $log"
  fi
  docker image prune -f >>"$log" 2>&1 || true
  if [[ -n $list ]]; then
    done_ "Add-ons built in: $list ($(elapsed))."
    enter_given_keys
    ask_licence_keys
  else
    done_ "No add-ons now; the app runs the release's own image ($(elapsed))."
  fi
}

account_url="${NICETRY_MARKETPLACE_URL:-https://nicetrybot.com}/account#composer"

saved_token() { env_get .env NICETRY_COMPOSER_TOKEN | tr -d "\"'"; }

# What's wrong with a Composer token (printed, and true), or nothing (false). A licence key (ntb1.…)
# looks like one, and was pasted in its place.
composer_token_problem() {
  local value=$1
  if [[ -z $value ]]; then
    echo "No Composer token yet."
  elif [[ $value == ntb1.* ]]; then
    echo "That's a licence key (ntb1.…), not a Composer token. Make a token at $account_url; it starts with ntbc_."
  elif [[ $value != ntbc_* ]]; then
    echo "A Composer token starts with ntbc_. Make one at $account_url."
  else
    return 1
  fi
}

# The keys given as NAME=KEY on the command line, one "slug key" line each, entered once the add-ons
# are built in. (A list rather than an associative array: macOS's bash 3.2 has none.)
given_keys=
enter_given_keys() {
  local slug key
  [[ -n $given_keys ]] || return 0
  say "Entering the licence keys"
  while read -r slug key; do
    [[ -n $slug ]] || continue
    if ! compose exec -T app php artisan addons:licence "$slug" "$key" </dev/null 2>&1 | sed 's/^/    /'; then
      warn "The key for $slug wasn't taken; check it on nicetrybot.com → Your licences, then: $(cmd "nicetrybot addons keys")"
    fi
  done <<<"$given_keys"
}

# Each paid add-on built in without a good licence key: ask for it here (or say where it goes), one
# key per add-on, from Your licences on nicetrybot.com. A skipped one runs on its 14-day trial.
ask_licence_keys() {
  local missing slug key
  # Releases before 0.4.0 don't have --missing: then just say where the keys go.
  if ! missing=$(compose exec -T app php artisan addons:licence --missing 2>/dev/null | tr -d '\r') ||
    grep -qvE '^[a-z0-9-]*$' <<<"$missing"; then
    [[ -n $given_keys ]] && return 0
    echo "Paid add-ons need their licence keys from nicetrybot.com → Your licences: paste each in Admin → Add-ons,"
    echo "or: $(cmd "nicetrybot artisan addons:licence <add-on> <key>")"
    return 0
  fi
  [[ -n $missing ]] || return 0

  if [[ $assume_yes == true || ! -r /dev/tty ]]; then
    echo "Paid add-ons need their licence keys from nicetrybot.com → Your licences: paste each in Admin → Add-ons, or"
    for slug in $missing; do echo "  $(cmd "nicetrybot artisan addons:licence $slug <key>")"; done
    return 0
  fi

  echo
  say "Licence keys: paste each from nicetrybot.com → Your licences (Enter skips one; it runs on a 14-day trial)"
  for slug in $missing; do
    read -r -p "    $slug: " key </dev/tty || break
    key=$(printf '%s' "$key" | tr -d '[:space:]')
    [[ -n $key ]] || continue
    if ! compose exec -T app php artisan addons:licence "$slug" "$key" 2>&1 | sed 's/^/      /'; then
      warn "That key wasn't taken for $slug; try again with: $(cmd "nicetrybot addons keys")"
    fi
  done
}

cmd_addons() {
  require_stack
  local action=${1:-list} before list name package
  [[ $# -gt 0 ]] && shift
  before=$(addons_list)

  case $action in
    list | ls)
      if [[ -z $before ]]; then
        echo "No marketplace add-ons are built in. Browse them at $(link_to https://nicetrybot.com/marketplace), then: $(cmd "nicetrybot addons add NAME")"
      else
        echo "Built in from NICETRY_ADDONS: $before"
      fi
      echo "Lockdown, Privacy mode and Rule packs come with NiceTryBot. Switch any add-on on or off in Admin → Add-ons."
      return 0
      ;;
    add)
      if [[ -n $token ]]; then
        composer_token_problem "$token" && fail "--token: $(composer_token_problem "$token")"
        env_set .env NICETRY_COMPOSER_TOKEN "$token"
      fi
      if composer_token_problem "$(saved_token)" >/dev/null; then
        [[ -r /dev/tty ]] || fail "Add-ons need a Composer token from $account_url: --token=ntbc_…"
        echo "Add-ons need a Composer token: make one at $account_url (it starts with ntbc_; it isn't a licence key)."
        while :; do
          read -r -s -p "Composer token: " token </dev/tty || fail "No token given."
          echo
          token=$(printf '%s' "$token" | tr -d '[:space:]')
          composer_token_problem "$token" || break
          echo "  $(composer_token_problem "$token")"
        done
        env_set .env NICETRY_COMPOSER_TOKEN "$token"
      fi
      list=$before
      for name in "$@"; do
        # captchas=ntb1.… : the add-on and its licence key.
        if [[ $name == *=* ]]; then
          given_keys+="$(basename "$(addon_package "${name%%=*}")") ${name#*=}"$'\n'
          name=${name%%=*}
        fi
        package=$(addon_package "$name")
        if [[ $package == all ]]; then
          list=all
        elif [[ $list != all && " $list " != *" ${package%%:*} "* && " $list " != *" ${package%%:*}:"* ]]; then
          list="${list:+$list }$package"
        fi
      done
      [[ $list == "$before" && $# -gt 0 ]] && echo "Already listed: $before. Building them in again, for their newest versions."
      [[ -n $list ]] || fail "Name an add-on to add, like: $(cmd "nicetrybot addons add captchas")"
      env_set .env NICETRY_ADDONS "\"$list\""
      say "Add-ons: $list"
      rebuild_addons "$before"
      ;;
    keys | licences | licence)
      ask_licence_keys
      local still
      still=$(compose exec -T app php artisan addons:licence --missing 2>/dev/null | tr -d '\r' | xargs || true)
      [[ -z $still ]] && done_ "Every paid add-on has its licence key."
      return 0
      ;;
    remove | rm)
      [[ $# -gt 0 ]] || fail "Name an add-on to take out, like: $(cmd "nicetrybot addons remove captchas")"
      [[ $before == all ]] && fail "NICETRY_ADDONS is \"all\": list the ones to keep instead, like: $(cmd "nicetrybot addons add captchas threats") (after setting NICETRY_ADDONS= in $dir/.env)"
      list=" $before "
      for name in "$@"; do
        package=$(addon_package "$name")
        package=${package%%:*}
        [[ $list == *" $package "* || $list == *" $package:"* ]] || fail "$package isn't built in (NICETRY_ADDONS: ${before:-empty})"
        list=$(printf '%s' "$list" | tr ' ' '\n' | grep -v -e "^$package\$" -e "^$package:" | xargs || true)
        list=" $list "
      done
      list=$(printf '%s' "$list" | xargs)
      env_set .env NICETRY_ADDONS "\"$list\""
      say "Add-ons: ${list:-none}"
      rebuild_addons "$before"
      ;;
    *) fail "$(cmd "nicetrybot addons [list|add NAME…|remove NAME…|keys]") (got $action)" ;;
  esac
}

# Settings changed by hand in .env: compose starts again what they change.
cmd_apply() {
  require_stack
  SECONDS=0
  apply_addons_file
  say "Starting the stack with $dir/.env"
  if ! start_stack keep || ! wait_healthy; then
    show_log_tail
    fail "The app didn't start healthy with these settings. Docker's output: $log"
  fi
  done_ "Applied ($(elapsed))."
}

# --- The doctor ---------------------------------------------------------------------------------

problems=0
warnings=0

heading() { printf '\n%s%s%s\n' "$c_bold" "$1" "$c_reset"; }

# One line: a mark, the check, what it found, and (in grey) what to do about it.
check() {
  local status=$1 name=$2 value=$3 advice=${4:-} mark
  case $status in
    ok) mark="${c_green}✓${c_reset}" ;;
    warn) mark="${c_yellow}!${c_reset}" warnings=$((warnings + 1)) ;;
    *) mark="${c_red}✗${c_reset}" problems=$((problems + 1)) ;;
  esac
  printf '  %s %-14s %s' "$mark" "$name" "$value"
  [[ -n $advice ]] && printf '   %s%s%s' "$c_dim" "$(sed "s/nicetrybot .*/${c_cyan}&/" <<<"$advice")" "$c_reset"
  printf '\n'
}

# Integer comparison of a decimal (like a load average) against a limit.
above() { awk -v a="$1" -v b="$2" 'BEGIN { exit !(a > b) }'; }

doctor_server() {
  local cores load mem_total mem_available swap_total swap_free swap_used swapped_out psi disk_free disk_pct disk_line
  heading "Server"

  cores=$(nproc 2>/dev/null || echo 1)
  read -r load _ < <(cut -d' ' -f2,3 /proc/loadavg)
  if above "$load" "$((cores * 2))"; then
    check fail CPU "$cores core(s), load $load over 5 min" "far more work than cores: a bigger server, or see nicetrybot logs"
  elif above "$load" "$cores"; then
    check warn CPU "$cores core(s), load $load over 5 min" "busy: more than one core's work per core"
  else
    check ok CPU "$cores core(s), load $load over 5 min"
  fi

  mem_total=$(awk '/^MemTotal:/ {print int($2 / 1024)}' /proc/meminfo)
  mem_available=$(awk '/^MemAvailable:/ {print int($2 / 1024)}' /proc/meminfo)
  if ((mem_total < 1900)); then
    check warn Memory "${mem_total} MB, ${mem_available} MB free" "NiceTryBot wants 2 GB: resize the server (on DigitalOcean, Resize → CPU and RAM only)"
  elif ((mem_available < 150)); then
    check warn Memory "${mem_total} MB, ${mem_available} MB free" "nearly full"
  else
    check ok Memory "${mem_total} MB, ${mem_available} MB free"
  fi

  swap_total=$(awk '/^SwapTotal:/ {print int($2 / 1024)}' /proc/meminfo)
  swap_free=$(awk '/^SwapFree:/ {print int($2 / 1024)}' /proc/meminfo)
  swap_used=$((swap_total - swap_free))
  # Pages swapped out over two seconds: swap that's merely full is fine, swap that's busy is slow.
  swapped_out=$(
    a=$(awk '/^pswpout / {print $2}' /proc/vmstat)
    sleep 2
    b=$(awk '/^pswpout / {print $2}' /proc/vmstat)
    echo $((b - a))
  )
  if ((swap_total == 0)); then
    ((mem_total < 1900)) && check warn Swap "none" "with under 2 GB of memory, a swap file keeps it from running out: run the installer again" || check ok Swap "none"
  elif ((swapped_out > 500)); then
    check warn Swap "${swap_used} of ${swap_total} MB used, swapping now" "out of memory, so everything slows down: more memory is the fix"
  else
    check ok Swap "${swap_used} of ${swap_total} MB used"
  fi

  if [[ -r /proc/pressure/memory ]]; then
    psi=$(awk '/^full/ { split($3, a, "="); print a[2] }' /proc/pressure/memory)
    if above "$psi" 10; then
      check fail Pressure "stalled on memory ${psi}% of the last minute" "the server is thrashing: more memory, or stop something"
    elif above "$psi" 1; then
      check warn Pressure "stalled on memory ${psi}% of the last minute" "short of memory"
    else
      check ok Pressure "no memory stalls in the last minute"
    fi
  fi

  disk_line=$(df -Pm / | tail -1)
  disk_free=$(awk '{print int($4 / 1024)}' <<<"$disk_line")
  disk_pct=$(awk '{gsub("%", "", $5); print 100 - $5}' <<<"$disk_line")
  if ((disk_free < 1 || disk_pct < 5)); then
    check fail Disk "${disk_free} GB free (${disk_pct}%)" "nearly full: docker image prune -a, or old backups in $backups"
  elif ((disk_free < 3 || disk_pct < 15)); then
    check warn Disk "${disk_free} GB free (${disk_pct}%)" "getting full: docker image prune -a frees old images"
  else
    check ok Disk "${disk_free} GB free (${disk_pct}%)"
  fi

  doctor_boots
}

# Since when it's been up, and whether the boot before ended out of memory (a crash, then a reboot).
doctor_boots() {
  local since previous_pressure oom
  since=$(uptime -s 2>/dev/null || true)
  command -v journalctl >/dev/null 2>&1 || {
    check ok Uptime "up since ${since:-?}"
    return 0
  }
  previous_pressure=$(journalctl -b -1 --no-pager -q 2>/dev/null | grep -c 'Under memory pressure' || true)
  oom=$(journalctl -k -b 0 --no-pager -q 2>/dev/null | grep -ciE 'out of memory|oom-kill' || true)
  if ((${previous_pressure:-0} > 100)); then
    check warn Uptime "up since ${since:-?}" "the boot before ended after $previous_pressure memory-pressure warnings: it ran out of memory and hung"
  else
    check ok Uptime "up since ${since:-?}"
  fi
  if ((${oom:-0} > 0)); then
    check warn "Out of memory" "$oom process(es) killed since boot" "journalctl -k | grep -i oom shows which"
  fi
}

doctor_containers() {
  local service id state health restarts oom memory stats
  heading "Containers"
  stats=$(docker stats --no-stream --format '{{.ID}} {{.MemUsage}}' 2>/dev/null | awk '{print $1, $2}' || true)
  for service in $(compose config --services 2>/dev/null); do
    id=$(compose ps -aq "$service" 2>/dev/null | head -n 1)
    if [[ -z $id ]]; then
      check fail "$service" "not created" "nicetrybot apply"
      continue
    fi
    read -r state health restarts oom < <(docker inspect -f '{{.State.Status}} {{if .State.Health}}{{.State.Health.Status}}{{else}}-{{end}} {{.RestartCount}} {{.State.OOMKilled}}' "$id")
    memory=$(awk -v id="${id:0:12}" '$1 == id {print $2}' <<<"$stats")
    local value="$state${health:+, $health}${memory:+, $memory}"
    value=${value/, -/}
    if [[ $state != running || $health == unhealthy ]]; then
      check fail "$service" "$value" "nicetrybot logs $service"
    elif [[ $oom == true ]]; then
      check warn "$service" "$value" "it was killed for want of memory"
    elif ((restarts > 0)); then
      check warn "$service" "$value, restarted $restarts time(s)" "nicetrybot logs $service"
    elif [[ $health == starting ]]; then
      check warn "$service" "$value" "still starting"
    else
      check ok "$service" "$value"
    fi
  done
}

# The panel through this server's own edge, as a visitor reaches it, and the edge's certificate for it.
doctor_panel() {
  local host result code time best='' slowest='' expires days
  host=$(env_get .env NICETRY_PANEL_HOST)
  heading "Panel  https://$host"
  for _ in 1 2 3; do
    result=$(curl -sk -o /dev/null -m 15 --resolve "$host:443:127.0.0.1" -w '%{http_code} %{time_total}' "https://$host/up" 2>/dev/null || echo "000 0")
    read -r code time <<<"$result"
    [[ $code == 200 ]] || break
    [[ -z $best ]] || above "$best" "$time" && best=$time
    [[ -z $slowest ]] || above "$time" "$slowest" && slowest=$time
  done
  if [[ $code != 200 ]]; then
    check fail Answers "HTTP $code from https://$host/up" "nicetrybot logs edge app"
  else
    local ms_best ms_slowest
    ms_best=$(awk -v t="$best" 'BEGIN {printf "%d", t * 1000}')
    ms_slowest=$(awk -v t="$slowest" 'BEGIN {printf "%d", t * 1000}')
    if ((ms_best > 1000)); then
      check warn Answers "in ${ms_best}–${ms_slowest} ms" "slow: see Server above"
    else
      check ok Answers "in ${ms_best}–${ms_slowest} ms"
    fi
  fi

  if command -v openssl >/dev/null 2>&1; then
    expires=$(echo | openssl s_client -connect 127.0.0.1:443 -servername "$host" 2>/dev/null | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2)
    if [[ -z $expires ]]; then
      check warn Certificate "none yet" "the edge gets one once $host points here: nicetrybot logs edge"
    else
      days=$((($(epoch "$expires") - $(date +%s)) / 86400))
      if ((days < 7)); then
        check fail Certificate "expires in $days day(s)" "the edge renews it itself; if it can't: nicetrybot logs edge"
      elif ((days < 20)); then
        check warn Certificate "expires in $days days" "renewal is due: nicetrybot logs edge"
      else
        check ok Certificate "good for $days days"
      fi
    fi
  fi
}

# The app's own checks (php artisan nicetry:doctor): the database, cache, queue, failed jobs, imports.
doctor_app() {
  local output status=0
  heading "App"
  output=$(compose exec -T app php artisan nicetry:doctor --ansi 2>&1) || status=$?
  if grep -q 'nicetry:doctor.*not defined\|There are no commands defined' <<<"$output"; then
    echo "  The app's own checks come with release 0.3.0: $(cmd "nicetrybot update")"
    return 0
  fi
  if [[ -z $(compose ps -q app 2>/dev/null) ]]; then
    check fail App "not running" "nicetrybot logs app"
    return 0
  fi
  printf '%s\n' "$output"
  warnings=$((warnings + $(grep -c '!' <<<"$output" || true)))
  ((status != 0)) && problems=$((problems + $(grep -c '✗' <<<"$output" || echo 1)))
  return 0
}

cmd_doctor() {
  require_stack
  banner
  local current
  current=$(running_version)
  printf '%sNiceTryBot v%s%s in %s\n' "$c_bold" "${current:-?}" "$c_reset" "$dir"
  doctor_server
  doctor_containers
  doctor_panel
  doctor_app
  echo
  if ((problems > 0)); then
    printf '%s✗ %d problem(s)%s, %d warning(s).\n' "$c_red" "$problems" "$c_reset" "$warnings"
    return 1
  elif ((warnings > 0)); then
    printf '%s!%s Working, with %s%d warning(s)%s.\n' "$c_yellow" "$c_reset" "$c_yellow" "$warnings" "$c_reset"
  else
    printf '%s✓ All good.%s\n' "$c_green" "$c_reset"
  fi
}

# --- Looking around -----------------------------------------------------------------------------

cmd_version() {
  # A laptop has no stack here: its version is the command's own.
  if [[ ! -f $dir/.env || ! -f $dir/compose.yml ]]; then
    cli_show_version
    return 0
  fi
  require_stack
  local current latest
  current=$(running_version)
  latest=$(latest_version || true)
  echo "NiceTryBot v${current:-?} (NICETRY_VERSION=$(env_get .env NICETRY_VERSION))"
  if [[ -z $latest ]]; then
    echo "Couldn't reach $NICETRY_RELEASE_BASE to find the newest release."
  elif [[ $latest == "$current" ]]; then
    echo "That's the newest release."
  else
    echo "${c_yellow}v$latest is out:${c_reset} $(link_to "$(notes_url "$latest")")   Update: $(cmd "nicetrybot update")"
  fi
}

cmd_status() {
  cmd_version
  echo
  compose ps --format 'table {{.Service}}\t{{.Status}}'
  echo
  echo "Panel:    https://$(env_get .env NICETRY_PANEL_HOST)"
  local addons
  addons=$(addons_list || true)
  echo "Add-ons:  ${addons:-none from the marketplace}"
  local newest
  newest=$(ls -1t "$backups"/*.sql.gz 2>/dev/null | head -n 1 || true)
  echo "Backup:   ${newest:-none yet (one is made before each update)}"
  [[ -f $updates/previous/state ]] && echo "Rollback: back to v$(state_get version) (updated $(state_get at))"
